# =============================================================================
# Manif' — variables d'environnement
# Copier vers .env et renseigner les valeurs. Ne jamais committer .env.
# =============================================================================

# --- Site ---
# Prod : https://manif.info — en local : http://localhost:3000
NUXT_PUBLIC_SITE_URL=https://manif.info
NUXT_PUBLIC_CONTACT_EMAIL=contact@manif.info

# Contribution financière via Ko-fi (widget + page /soutenir)
NUXT_PUBLIC_KOFI_USERNAME=manif
NUXT_PUBLIC_KOFI_AMOUNTS=1,5,10
# Ou URL complète HTTPS (si USERNAME vide)
# NUXT_PUBLIC_KOFI_URL=https://ko-fi.com/manif

# Mentions légales
NUXT_PUBLIC_LEGAL_EDITOR_NAME=Manif'
NUXT_PUBLIC_LEGAL_EDITOR_ADDRESS=France — adresse postale disponible sur demande à contact@manif.info
NUXT_PUBLIC_LEGAL_HOST_NAME=
NUXT_PUBLIC_LEGAL_HOST_ADDRESS=
NUXT_PUBLIC_LEGAL_HOST_PHONE=

# --- Base de données ---
# false (défaut) = PostgreSQL via Supabase
# true = données fictives en mémoire (dev sans Supabase)
NUXT_PUBLIC_USE_MOCK_DB=false

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Sur Vercel, préférer aussi (override runtime Nuxt) :
# NUXT_SUPABASE_URL=…
# NUXT_SUPABASE_SERVICE_ROLE_KEY=…   ← service_role / sb_secret_… (PAS anon / sb_publishable_)

# --- Engagements (soutien / participation) ---
# Opt-out : false. Ne pas utiliser l’ancien NUXT_PUBLIC_PARTICIPATION_ENABLED.
NUXT_PUBLIC_ENGAGEMENTS_ENABLED=true
PARTICIPATION_TOKEN_PEPPER=change-me-to-a-long-random-string

# --- Auth admin ---
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Préférer NUXT_* (évite qu’un ADMIN_PASSWORD du shell écrase le .env)
NUXT_ADMIN_EMAIL=contact@manif.info
NUXT_ADMIN_PASSWORD=change-me-strong-password
# Alias optionnels : ADMIN_EMAIL / ADMIN_PASSWORD
# ADMIN_ALLOW_ANY=true autorise tout compte Supabase Auth (déconseillé)
ADMIN_ALLOW_ANY=false

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Manif' <contact@manif.info>

# --- Antibot (Cloudflare Turnstile) ---
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames frontend autorisés (siteverify). Prod : sans localhost.
TURNSTILE_HOSTNAMES=manif.info,www.manif.info,localhost,127.0.0.1

# --- Rate limit distribué (optionnel) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=change-me

# --- Carte (MapLibre) ---
NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NUXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap © OpenFreeMap
